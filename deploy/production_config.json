{
  "version": "1.0.0",
  "deployment_date": "2026-08-30",
  "environment": "production",
  "threshold_table": {
    "new|domestic": [0.40, 0.85],
    "new|cross_border": [0.30, 0.75],
    "established|domestic": [0.55, 0.90],
    "established|cross_border": [0.45, 0.85],
    "vip|domestic": [0.65, 0.95],
    "vip|cross_border": [0.55, 0.90]
  },
  "fraud_ceiling": 5000.0,
  "fallback": {
    "enabled": true,
    "stale_threshold_days": 7
  },
  "logging": {
    "level": "INFO",
    "output": "logs/decision.log"
  },
  "endpoints": {
    "decide": "/decide",
    "outcome": "/outcome",
    "health": "/health"
  }
}